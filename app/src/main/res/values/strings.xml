    <string name="playbook_ble_summary">Pair with the intended Bruce device and confirm the remote-control path.</string>
    <string name="playbook_wifi_title">Passive Wi-Fi survey</string>
    <string name="playbook_wifi_summary">Record observations from an authorized lab area without connecting to access points.</string>
    <string name="playbook_ir_title">IR inventory and capture</string>
    <string name="playbook_ir_summary">Build a labeled, reproducible infrared command inventory for equipment you control.</string>
    <string name="playbook_modules_title">Review firmware modules</string>
    <string name="playbook_modules_summary">Inspect device files and scripts before running or changing them.</string>
    <string-array name="playbook_ble_steps">
        <item>Confirm this is the Bruce device assigned to the lab.</item>
        <item>Enable Bluetooth and the Bruce BLE API on the device.</item>
        <item>Connect and verify the device name and screen state.</item>
        <item>Record firmware version, findings and disconnect cleanly.</item>
    </string-array>
    <string-array name="playbook_wifi_steps">
        <item>Confirm written authorization and the survey location.</item>
        <item>Enable Wi-Fi and grant Android scan permissions if requested.</item>
        <item>Record SSID, BSSID, channel and signal observations.</item>
        <item>Do not attempt association, deauthentication or credential capture.</item>
        <item>Add findings to the active session and export the report.</item>
    </string-array>
    <string-array name="playbook_ir_steps">
        <item>Confirm the equipment owner and permitted test window.</item>
        <item>Create a clearly named remote folder for the target.</item>
        <item>Capture or import one command at a time and label its function.</item>
        <item>Test only against the intended equipment and document results.</item>
    </string-array>
    <string-array name="playbook_modules_steps">
        <item>Connect to the intended Bruce device over BLE.</item>
        <item>Review module names and file paths before opening files.</item>
        <item>Inspect script contents and source before executing on hardware.</item>
        <item>Back up changed files and note firmware version and changes.</item>
    </string-array>

